# Copy to .env.local for local testing; set the same names in the hosting environment.
# Never commit real values.

# --- Site (baked in at build time) ---
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_SITE_ENV=production

# --- Leads → Google Sheets (Apps Script web app, see docs/google-sheets-apps-script.gs) ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- Leads → CRM (JSON webhook) ---
CRM_WEBHOOK_URL=
# Header used for the CRM token, e.g. Authorization (with "Bearer xxx" as the token) or x-api-key
CRM_AUTH_HEADER=Authorization
CRM_AUTH_TOKEN=

# --- Leads → email (SMTP) ---
# Google Workspace / Gmail: smtp.gmail.com, port 465 or 587, an App Password as SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM="Skyven Website <leads@your-domain.com>"
# One or more addresses, comma separated
LEAD_EMAIL_TO=sales@your-domain.com
